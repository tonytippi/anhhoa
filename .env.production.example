# Sao chép file này thành .env.production. Không commit file đó hoặc điền secret vào file mẫu.
# PostgreSQL chỉ được dùng nội bộ bởi Compose và không có host port.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# URL nội bộ Compose, dùng hostname `postgres`, ví dụ postgresql://user:password@postgres:5432/database?schema=public.
DATABASE_URL=

# Cổng HTTP nội bộ để Cloudflare Tunnel trỏ vào, ví dụ 8080.
WEB_PORT=8080

# Public HTTPS origin duy nhất của web gateway, không có dấu / ở cuối.
WEB_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback Google phải cùng public origin, ví dụ https://admin.example.com/api/auth/google/callback.
GOOGLE_CALLBACK_URL=
# URL sau đăng nhập, phân tách bằng dấu phẩy; URL denied phải là một URL trong danh sách này.
OAUTH_REDIRECT_URLS=
OAUTH_DENIED_REDIRECT_URL=
# Ít nhất 32 ký tự.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Email admin, phân tách bằng dấu phẩy.
ADMIN_EMAILS=
CSRF_COOKIE_NAME=csrf_token
