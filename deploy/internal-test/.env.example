# Copy thành .env (không commit). Secret/OAuth lấy giống apps/api/.env; database là PostgreSQL trong Compose.
POSTGRES_DB=passionedu
POSTGRES_USER=passionedu
POSTGRES_PASSWORD=__REQUIRED_SECRET__

SUPERADMIN_EMAIL=__REQUIRED_OPERATOR_EMAIL__
GOOGLE_CLIENT_ID=__REQUIRED_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__REQUIRED_SECRET__
SESSION_SECRET=__REQUIRED_SECRET_AT_LEAST_32_CHARACTERS__
OAUTH_STATE_TTL_SECONDS=600
SESSION_TTL_SECONDS=86400
BANK_DEEP_LINK_CONFIG=

# Public host của từng portal (Cloudflare Tunnel). Google OAuth phải đăng ký redirect URI
# https://<HOST>/api/<audience>/auth/google/callback cho từng host.
APP_HOST=app.passionedu.org
TEACHER_HOST=teacher.passionedu.org
PARENT_HOST=parent.passionedu.org
OPS_HOST=ops.passionedu.org

# Host port (bind 127.0.0.1) để cloudflared trỏ vào.
APP_PORT=9000
TEACHER_PORT=9001
PARENT_PORT=9002
OPS_PORT=9003
API_PORT=9004
POSTGRES_PORT=9005

APP_SESSION_COOKIE_NAME=app_session
APP_CSRF_COOKIE_NAME=app_csrf
TEACHER_SESSION_COOKIE_NAME=teacher_session
TEACHER_CSRF_COOKIE_NAME=teacher_csrf
PARENT_SESSION_COOKIE_NAME=parent_session
PARENT_CSRF_COOKIE_NAME=parent_csrf
OPS_SESSION_COOKIE_NAME=ops_session
OPS_CSRF_COOKIE_NAME=ops_csrf
