TEACHER_GOOGLE_CALLBACK_URL=https://api.passionedu.org/api/teacher/auth/google/callback
TEACHER_OAUTH_REDIRECT_URLS=https://teacher.passionedu.org
TEACHER_OAUTH_DENIED_REDIRECT_URL=https://teacher.passionedu.org
TEACHER_SESSION_COOKIE_NAME=teacher_session
TEACHER_CSRF_COOKIE_NAME=teacher_csrf
PARENT_WEB_ORIGIN=https://parent.passionedu.org
PARENT_GOOGLE_CALLBACK_URL=https://api.passionedu.org/api/parent/auth/google/callback
PARENT_OAUTH_REDIRECT_URLS=https://parent.passionedu.org
PARENT_OAUTH_DENIED_REDIRECT_URL=https://parent.passionedu.org
PARENT_SESSION_COOKIE_NAME=parent_session
PARENT_CSRF_COOKIE_NAME=parent_csrf
OPS_WEB_ORIGIN=https://ops.passionedu.org
OPS_GOOGLE_CALLBACK_URL=https://api.passionedu.org/api/ops/auth/google/callback
OPS_OAUTH_REDIRECT_URLS=https://ops.passionedu.org
