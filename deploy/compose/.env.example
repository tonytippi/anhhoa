POSTGRES_DB=__REQUIRED_DATABASE_NAME__
POSTGRES_USER=__REQUIRED_DATABASE_USER__
POSTGRES_PASSWORD=__REQUIRED_SECRET__
DATABASE_URL=postgresql://__REQUIRED_DATABASE_USER__:__REQUIRED_SECRET__@postgres:5432/__REQUIRED_DATABASE_NAME__
SUPERADMIN_EMAIL=__REQUIRED_OPERATOR_EMAIL__
GOOGLE_CLIENT_ID=__REQUIRED_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__REQUIRED_SECRET__
SESSION_SECRET=__REQUIRED_SECRET_AT_LEAST_32_CHARACTERS__
OAUTH_STATE_TTL_SECONDS=600
SESSION_TTL_SECONDS=86400
APP_WEB_ORIGIN=https://app.passionedu.org
APP_GOOGLE_CALLBACK_URL=https://api.passionedu.org/api/app/auth/google/callback
APP_OAUTH_REDIRECT_URLS=https://app.passionedu.org
APP_OAUTH_DENIED_REDIRECT_URL=https://app.passionedu.org
APP_SESSION_COOKIE_NAME=app_session
APP_CSRF_COOKIE_NAME=app_csrf
