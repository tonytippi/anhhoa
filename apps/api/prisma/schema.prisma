generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String
  avatarUrl   String?
  googleId    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  operations  Operation[]
}

enum OperationState {
  COMPLETED
}

model Operation {
  id          String         @db.Uuid
  adminId     String         @db.Uuid
  route       String
  fingerprint String
  state       OperationState @default(COMPLETED)
  response    Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  admin       Admin          @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@id([adminId, route, id])
  @@index([id])
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Class {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  monthlyTuition BigInt
  status         ClassStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  students       Student[]

  @@index([status])
}

model Student {
  id        String        @id @default(uuid()) @db.Uuid
  fullName  String
  nickname  String?
  status    StudentStatus @default(ACTIVE)
  classId   String?       @db.Uuid
  class     Class?        @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([classId, status])
}
