generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String
  avatarUrl   String?
  googleId    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
