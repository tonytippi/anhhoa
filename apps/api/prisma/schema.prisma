generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model School {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  status      SchoolStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  initialOwnerIdentityId String? @db.Uuid
  studentCodePrefix String
  studentCodeSequence Int @default(0)
  memberships SchoolMembership[]
  positions SchoolPosition[]
  audits      AuditRecord[]
  operations  Operation[]
  schoolYears SchoolYear[]
  classes     Class[]
  students    Student[]
  staffProfiles StaffProfile[]
  staffClassAssignments StaffClassAssignment[]
  enrollments StudentEnrollment[]
  enrollmentClassAssignments EnrollmentClassAssignment[]
  studentParents StudentParent[]
  enrollmentLifecycleTransitions StudentEnrollmentLifecycleTransition[]
  profileVersions SchoolProfileVersion[]
  calendarVersions SchoolCalendarVersion[]
  financePolicies FinancePolicy[]
  attendancePolicies AttendancePolicy[]
  handoverPolicies HandoverPolicy[]
  dailyJournalPolicies DailyJournalPolicy[]
  leavePolicies LeavePolicy[]
  leaveRequests LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  evidenceReferences EvidenceReference[]
  notificationSourceEvents NotificationSourceEvent[]
  bankAccounts BankAccount[]
  initialOwnerIdentity UserIdentity? @relation("InitialSchoolOwner", fields: [initialOwnerIdentityId], references: [id], onDelete: Restrict)
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum StudentEnrollmentLifecycle {
  TRIAL
  WAITING_FOR_CLASS
  SCHEDULED_TO_START
  ENROLLED
  ON_LEAVE
  WITHDRAWN
  GRADUATED
}

model SchoolYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes   Class[]
  enrollments StudentEnrollment[]
  staffClassAssignments StaffClassAssignment[]
  enrollmentClassAssignments EnrollmentClassAssignment[]
  closedAt DateTime?
  closedByMembershipId String? @db.Uuid
  closeOperationId String? @unique @db.Uuid
  closeOperation Operation? @relation("SchoolYearCloseOperation", fields: [schoolId, closeOperationId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, startsOn])
}

model Class {
  id           String      @id @default(uuid()) @db.Uuid
  schoolId     String      @db.Uuid
  schoolYearId String      @db.Uuid
  name         String
  status       ClassStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolYear   SchoolYear  @relation(fields: [schoolId, schoolYearId], references: [schoolId, id], onDelete: Restrict)
  enrollments  StudentEnrollment[]
  staffClassAssignments StaffClassAssignment[]
  enrollmentClassAssignments EnrollmentClassAssignment[]
  attendanceRecords AttendanceRecord[]
  uploadedEvidenceReferences EvidenceReference[] @relation("EvidenceUploadedClass")

  @@index([schoolId, schoolYearId])
  @@unique([schoolId, id])
  @@unique([schoolId, schoolYearId, id])
}

model StaffProfile {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  fullName    String
  email       String
  phone       String
  dateOfBirth DateTime @db.Date
  gender      String
  address     String
  employmentStatus StaffEmploymentStatus @default(ACTIVE)
  primaryPositionId String @db.Uuid
  schoolMembershipId String? @unique @db.Uuid
  boundAt DateTime?
  boundByMembershipId String? @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  primaryPosition SchoolPosition @relation(fields: [schoolId, primaryPositionId], references: [schoolId, id], onDelete: Restrict)
  schoolMembership SchoolMembership? @relation("StaffProfileLoginBinding", fields: [schoolId, schoolMembershipId], references: [schoolId, id], onDelete: Restrict)
  boundByMembership SchoolMembership? @relation("StaffProfileBindingAuditor", fields: [schoolId, boundByMembershipId], references: [schoolId, id], onDelete: Restrict)
  assignments StaffClassAssignment[]
  attendanceRecords AttendanceRecord[]
  uploadedEvidenceReferences EvidenceReference[] @relation("EvidenceUploadedStaffProfile")

  @@unique([schoolId, id])
  @@unique([schoolId, primaryPositionId, id])
  @@unique([schoolId, schoolMembershipId])
  @@index([schoolId, fullName])
}

enum StaffEmploymentStatus {
  ACTIVE
  INACTIVE
}

enum SchoolPositionStatus {
  ACTIVE
  INACTIVE
}

model SchoolPosition {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  code String
  name String
  status SchoolPositionStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  grants PositionCapabilityGrant[]
  staffProfiles StaffProfile[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, status])
}

model PositionCapabilityGrant {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  positionId String @db.Uuid
  capability String
  createdAt DateTime @default(now())
  position SchoolPosition @relation(fields: [schoolId, positionId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, positionId, capability])
  @@index([schoolId, capability])
}

model StaffClassAssignment {
  id                  String       @id @default(uuid()) @db.Uuid
  schoolId            String       @db.Uuid
  staffProfileId      String       @db.Uuid
  schoolYearId        String       @db.Uuid
  classId             String       @db.Uuid
  effectiveFrom       DateTime     @db.Date
  effectiveTo         DateTime?    @db.Date
   reason              String
   endReason           String?
  schoolYearName      String
  schoolYearStartsOn  DateTime     @db.Date
  schoolYearEndsOn    DateTime     @db.Date
  className           String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  school              School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staffProfile        StaffProfile @relation(fields: [schoolId, staffProfileId], references: [schoolId, id], onDelete: Restrict)
  schoolYear          SchoolYear   @relation(fields: [schoolId, schoolYearId], references: [schoolId, id], onDelete: Restrict)
  classroom           Class        @relation(fields: [schoolId, schoolYearId, classId], references: [schoolId, schoolYearId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, schoolYearId, effectiveFrom])
  @@index([schoolId, staffProfileId, effectiveFrom])
  @@index([schoolId, classId, effectiveFrom])
}

enum LeaveRequestStatus {
  PENDING
  AUTO_APPROVED
  APPROVED
  REJECTED
}

model LeavePolicy {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  effectiveFrom DateTime @db.Date
  nextDayDeadlineLocalTime String
  actorIdentityId String @db.Uuid
  membershipId String @db.Uuid
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

model LeaveRequest {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  parentProfileId String @db.Uuid
  status LeaveRequestStatus
  policyEffectiveFrom DateTime @db.Date
  policyDeadlineLocalTime String
  rejectedReason String?
  decidedAt DateTime?
  decidedByMembershipId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  parentProfile ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Restrict)
  studentParent StudentParent @relation(fields: [schoolId, studentId, parentProfileId], references: [schoolId, studentId, parentProfileId], onDelete: Restrict)
  decidedByMembership SchoolMembership? @relation("LeaveRequestDecisionMembership", fields: [schoolId, decidedByMembershipId], references: [schoolId, id], onDelete: Restrict)
  days LeaveRequestDay[]
  @@unique([schoolId, id])
  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, parentProfileId, createdAt])
  @@index([schoolId, decidedByMembershipId, createdAt])
}

model LeaveRequestDay {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  leaveRequestId String @db.Uuid
  operatingOn DateTime @db.Date
  calendarEffectiveFrom DateTime @db.Date
  createdAt DateTime @default(now())
  leaveRequest LeaveRequest @relation(fields: [schoolId, leaveRequestId], references: [schoolId, id], onDelete: Restrict)
  calendarVersion SchoolCalendarVersion @relation(fields: [schoolId, calendarEffectiveFrom], references: [schoolId, effectiveFrom], onDelete: Restrict)
  @@unique([schoolId, leaveRequestId, operatingOn])
  @@index([schoolId, operatingOn])
}

model Student {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  studentCode String
  fullName    String
  dateOfBirth DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollments StudentEnrollment[]
  parentLinks StudentParent[]
  leaveRequests LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  confirmedEvidenceReferences EvidenceReference[] @relation("EvidenceConfirmedStudent")
  notificationSourceEvents NotificationSourceEvent[]

  @@unique([schoolId, id])
  @@index([schoolId, studentCode])
}

model StudentEnrollment {
  id               String                     @id @default(uuid()) @db.Uuid
  schoolId         String                     @db.Uuid
  studentId        String                     @db.Uuid
  schoolYearId     String                     @db.Uuid
  classId          String                     @db.Uuid
  lifecycle        StudentEnrollmentLifecycle
  effectiveFrom    DateTime                   @db.Date
  endedOn          DateTime?                  @db.Date
  schoolYearName   String
  schoolYearStartsOn DateTime                 @db.Date
  schoolYearEndsOn DateTime                   @db.Date
  className        String
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  school           School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student          Student                    @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  schoolYear       SchoolYear                 @relation(fields: [schoolId, schoolYearId], references: [schoolId, id], onDelete: Restrict)
  classroom        Class                      @relation(fields: [schoolId, schoolYearId, classId], references: [schoolId, schoolYearId, id], onDelete: Restrict)
  lifecycleTransitions StudentEnrollmentLifecycleTransition[]
  classAssignments EnrollmentClassAssignment[]

  @@unique([schoolId, studentId, schoolYearId])
  @@unique([schoolId, id])
  @@index([schoolId, classId, lifecycle])
  @@index([schoolId, studentId, createdAt])
}

model EnrollmentClassAssignment {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  enrollmentId String @db.Uuid
  schoolYearId String @db.Uuid
  classId String @db.Uuid
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  reason String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollment StudentEnrollment @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Restrict)
  schoolYear SchoolYear @relation(fields: [schoolId, schoolYearId], references: [schoolId, id], onDelete: Restrict)
  classroom Class @relation(fields: [schoolId, schoolYearId, classId], references: [schoolId, schoolYearId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, enrollmentId, effectiveFrom])
  @@index([schoolId, classId, effectiveFrom])
}

model StudentEnrollmentLifecycleTransition {
  id             String                     @id @default(uuid()) @db.Uuid
  schoolId       String                     @db.Uuid
  enrollmentId   String                     @db.Uuid
  previousLifecycle StudentEnrollmentLifecycle?
  lifecycle      StudentEnrollmentLifecycle
  effectiveFrom  DateTime                   @db.Date
  endedOn        DateTime?                  @db.Date
  actorIdentityId String                    @db.Uuid
  membershipId   String                     @db.Uuid
  operationId    String                     @db.Uuid
  createdAt      DateTime                   @default(now())
  school         School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollment     StudentEnrollment          @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, enrollmentId, createdAt])
  @@index([schoolId, operationId])
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum FinanceTaxTreatment {
  NOT_APPLICABLE
  TAX_INCLUDED
  TAX_EXCLUDED
}

enum FinanceDebtScope {
  CURRENT_SCHOOL_YEAR_ONLY
}

enum FinanceReversalMode {
  DIRECT
  SCHOOL_ADMIN_APPROVAL
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
}

enum PhotoEvidenceMode {
  REQUIRED
  OPTIONAL
}

enum DailyJournalImageMimeType {
  JPEG
  PNG
  WEBP
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum OperationActorType {
  SCHOOL_MEMBERSHIP
  PLATFORM_OPERATOR_GRANT
  PARENT_PROFILE
}

enum OperationStatus {
  PENDING
  COMPLETED
  FAILED
}

model UserIdentity {
  id              String             @id @default(uuid()) @db.Uuid
  emailNormalized String             @unique
  googleSubject   String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships     SchoolMembership[]
  audits          AuditRecord[]
  operations      Operation[]
  platformGrant   PlatformOperatorGrant?
  initiallyOwnedSchools School[] @relation("InitialSchoolOwner")
  parentProfile ParentProfile?
}

enum StudentParentStatus {
  ACTIVE
  REVOKED
}

model ParentProfile {
  id              String          @id @default(uuid()) @db.Uuid
  emailNormalized String          @unique
  fullName        String
  phone           String
  userIdentityId  String?         @unique @db.Uuid
  boundAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  userIdentity    UserIdentity?   @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  studentParents  StudentParent[]
  leaveRequests LeaveRequest[]
}

model StudentParent {
  id              String              @id @default(uuid()) @db.Uuid
  schoolId        String              @db.Uuid
  studentId       String              @db.Uuid
  parentProfileId String              @db.Uuid
  status          StudentParentStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())
  revokedAt       DateTime?
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student         Student             @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  parentProfile   ParentProfile       @relation(fields: [parentProfileId], references: [id], onDelete: Restrict)
  leaveRequests   LeaveRequest[]

  @@unique([schoolId, id])
  @@unique([schoolId, studentId, parentProfileId])
  @@index([parentProfileId, status])
  @@index([schoolId, studentId, status])
}

model OAuthTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  audience        String
  stateHash       String   @unique
  correlationHash String
  nonce           String
  redirect        String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([audience, expiresAt])
}

model PlatformOperatorGrant {
  id             String       @id @default(uuid()) @db.Uuid
  userIdentityId String       @unique @db.Uuid
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
  userIdentity   UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  operations     Operation[]
}

model SchoolMembership {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  userIdentityId String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userIdentity   UserIdentity     @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  audits         AuditRecord[]      @relation("AuditMembership")
  operations     Operation[]        @relation("OperationMembership")
  financePolicies FinancePolicy[]
  attendancePolicies AttendancePolicy[]
  attendanceRecords AttendanceRecord[]
  handoverPolicies HandoverPolicy[]
  dailyJournalPolicies DailyJournalPolicy[]
  leavePolicies LeavePolicy[]
  boundStaffProfile StaffProfile? @relation("StaffProfileLoginBinding")
  auditedStaffProfileBindings StaffProfile[] @relation("StaffProfileBindingAuditor")
  decidedLeaveRequests LeaveRequest[] @relation("LeaveRequestDecisionMembership")
  bankAccounts BankAccount[]
  bankAccountLifecycleTransitions BankAccountLifecycleTransition[]
  uploadedEvidenceReferences EvidenceReference[] @relation("EvidenceUploadedMembership")

  @@unique([schoolId, userIdentityId])
  @@unique([schoolId, id])
  @@index([schoolId, status])
}


model AuditRecord {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  actorIdentityId String?         @db.Uuid
  membershipId   String?          @db.Uuid
  actorType      OperationActorType?
  actorReference String?
  action         String
  reason         String?
  provenance     Json?
  createdAt      DateTime         @default(now())
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actorIdentity  UserIdentity?    @relation(fields: [actorIdentityId], references: [id], onDelete: Restrict)
  membership     SchoolMembership? @relation("AuditMembership", fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, createdAt])
}

model Operation {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String?            @db.Uuid
  membershipId    String?            @db.Uuid
  platformOperatorGrantId String?    @db.Uuid
  actorIdentityId String?            @db.Uuid
  actorType       OperationActorType
  actorReference  String
  route           String
  fingerprint     String
  idempotencyKey  String
  status          OperationStatus    @default(PENDING)
  outcome         Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  school          School?            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership      SchoolMembership?  @relation("OperationMembership", fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  platformOperatorGrant PlatformOperatorGrant? @relation(fields: [platformOperatorGrantId], references: [id], onDelete: Restrict)
  actorIdentity   UserIdentity?      @relation(fields: [actorIdentityId], references: [id], onDelete: Restrict)
  closedSchoolYears SchoolYear[]     @relation("SchoolYearCloseOperation")
  bankAccountLifecycleTransitions BankAccountLifecycleTransition[] @relation("BankAccountLifecycleOperation")

  // PostgreSQL partial unique indexes below are migration-owned because Prisma cannot express predicates.
  @@index([schoolId, actorType, actorReference, route, idempotencyKey])
  @@index([platformOperatorGrantId, actorType, actorReference, route, idempotencyKey])
  @@index([platformOperatorGrantId, createdAt])
  @@index([schoolId, route])
  @@unique([schoolId, id])
}

model SchoolProfileVersion {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @db.Uuid
  effectiveFrom     DateTime @db.Date
  schoolName        String
  address           String?
  phone             String?
  actorIdentityId   String   @db.Uuid
  membershipId      String   @db.Uuid
  createdAt         DateTime @default(now())
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

model SchoolCalendarVersion {
  id                String                  @id @default(uuid()) @db.Uuid
  schoolId          String                  @db.Uuid
  effectiveFrom     DateTime                @db.Date
  actorIdentityId   String                  @db.Uuid
  membershipId      String                  @db.Uuid
  createdAt         DateTime                @default(now())
  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  holidays          SchoolCalendarHoliday[]
  leaveRequestDays  LeaveRequestDay[]

  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

model SchoolCalendarHoliday {
  id                String                @id @default(uuid()) @db.Uuid
  schoolId          String                @db.Uuid
  calendarVersionId String                @db.Uuid
  name              String
  startsOn          DateTime              @db.Date
  endsOn            DateTime              @db.Date
  createdAt         DateTime              @default(now())
  calendarVersion   SchoolCalendarVersion @relation(fields: [schoolId, calendarVersionId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, calendarVersionId, startsOn])
}

model FinancePolicy {
  id                String              @id @default(uuid()) @db.Uuid
  schoolId          String              @db.Uuid
  effectiveFrom     DateTime            @db.Date
  dueDaysAfterIssue Int
  taxTreatment      FinanceTaxTreatment
  debtScope         FinanceDebtScope
  reversalMode      FinanceReversalMode
  reason            String?
  actorIdentityId   String              @db.Uuid
  membershipId      String              @db.Uuid
  createdAt         DateTime            @default(now())
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership        SchoolMembership    @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

model AttendancePolicy {
  id                String            @id @default(uuid()) @db.Uuid
  schoolId          String            @db.Uuid
  effectiveFrom     DateTime          @db.Date
  photoEvidenceMode PhotoEvidenceMode
  reason            String
  actorIdentityId   String            @db.Uuid
  membershipId      String            @db.Uuid
  createdAt         DateTime          @default(now())
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership        SchoolMembership  @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

enum AttendanceState {
  PRESENT
  ABSENT
}

model EvidenceReference {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @db.Uuid
  contentType         String
  uploadedClassId     String?  @db.Uuid
  uploadedAttendanceOn DateTime? @db.Date
  uploadedMembershipId String? @db.Uuid
  uploadedStaffProfileId String? @db.Uuid
  blob                Bytes?
  preview             Bytes?
  confirmedAt         DateTime?
  confirmedStudentId  String?  @db.Uuid
  confirmedAttendanceOn DateTime? @db.Date
  deletedAt           DateTime?
  deletionReason      String?
  createdAt           DateTime @default(now())
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  uploadedClass       Class?    @relation("EvidenceUploadedClass", fields: [schoolId, uploadedClassId], references: [schoolId, id], onDelete: Restrict)
  uploadedMembership  SchoolMembership? @relation("EvidenceUploadedMembership", fields: [schoolId, uploadedMembershipId], references: [schoolId, id], onDelete: Restrict)
  uploadedStaffProfile StaffProfile? @relation("EvidenceUploadedStaffProfile", fields: [schoolId, uploadedStaffProfileId], references: [schoolId, id], onDelete: Restrict)
  confirmedStudent    Student? @relation("EvidenceConfirmedStudent", fields: [schoolId, confirmedStudentId], references: [schoolId, id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, id])
  @@index([schoolId, uploadedClassId, uploadedAttendanceOn])
}

model NotificationSourceEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @db.Uuid
  sourceType         NotificationSourceType
  sourceRecordId     String   @db.Uuid
  studentId          String   @db.Uuid
  attendanceOn       DateTime @db.Date
  state              AttendanceState
  payload            Json
  createdAt          DateTime @default(now())
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student            Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, sourceType, sourceRecordId])
  @@index([schoolId, studentId, attendanceOn])
}

enum NotificationSourceType {
  ATTENDANCE
}

model AttendanceRecord {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  classId String @db.Uuid
  studentId String @db.Uuid
  attendanceOn DateTime @db.Date
  state AttendanceState
  evidenceId String? @db.Uuid
  policyEffectiveFrom DateTime @db.Date
  actorIdentityId String @db.Uuid
  membershipId String @db.Uuid
  staffProfileId String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classroom Class @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  evidence EvidenceReference? @relation(fields: [schoolId, evidenceId], references: [schoolId, id], onDelete: Restrict)
  policy AttendancePolicy @relation(fields: [schoolId, policyEffectiveFrom], references: [schoolId, effectiveFrom], onDelete: Restrict)
  membership SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  staffProfile StaffProfile @relation(fields: [schoolId, staffProfileId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, classId, studentId, attendanceOn])
  @@unique([schoolId, id])
  @@unique([schoolId, evidenceId])
  @@index([schoolId, classId, attendanceOn])
  @@index([schoolId, studentId, attendanceOn])
}

model HandoverPolicy {
  id                String            @id @default(uuid()) @db.Uuid
  schoolId          String            @db.Uuid
  effectiveFrom     DateTime          @db.Date
  photoEvidenceMode PhotoEvidenceMode
  reason            String
  actorIdentityId   String            @db.Uuid
  membershipId      String            @db.Uuid
  createdAt         DateTime          @default(now())
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership        SchoolMembership  @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

model DailyJournalPolicy {
  id                String            @id @default(uuid()) @db.Uuid
  schoolId          String            @db.Uuid
  effectiveFrom     DateTime          @db.Date
  parentRetentionDaysAfterEnrollmentEnded Int
  acceptedImageMimeTypes DailyJournalImageMimeType[]
  maxImageSizeBytes Int
  imageCountLimit   Int?
  reason            String
  actorIdentityId   String            @db.Uuid
  membershipId      String            @db.Uuid
  createdAt         DateTime          @default(now())
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership        SchoolMembership  @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

model BankAccount {
  id                 String            @id @default(uuid()) @db.Uuid
  schoolId           String            @db.Uuid
  receivingBank      String
  accountNumber      String
  accountHolderName  String
  transferTemplate   String
  actorIdentityId    String            @db.Uuid
  membershipId       String            @db.Uuid
  createdAt          DateTime          @default(now())
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership         SchoolMembership  @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  lifecycleTransitions BankAccountLifecycleTransition[]

  @@unique([schoolId, id])
  @@index([schoolId, createdAt])
}

model BankAccountLifecycleTransition {
  id              String            @id @default(uuid()) @db.Uuid
  schoolId        String            @db.Uuid
  bankAccountId   String            @db.Uuid
  previousStatus  BankAccountStatus?
  status          BankAccountStatus
  reason          String?
  actorIdentityId String            @db.Uuid
  membershipId    String            @db.Uuid
  operationId     String            @db.Uuid
  sequence        Int
  changedAt       DateTime          @default(now())
  bankAccount     BankAccount       @relation(fields: [schoolId, bankAccountId], references: [schoolId, id], onDelete: Restrict)
  membership      SchoolMembership  @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  operation       Operation         @relation("BankAccountLifecycleOperation", fields: [schoolId, operationId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, bankAccountId, sequence])
  @@index([schoolId, bankAccountId, sequence])
  @@index([schoolId, operationId])
}
