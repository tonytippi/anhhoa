generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String
  avatarUrl   String?
  googleId    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  operations  Operation[]
  createdInvoices Invoice[] @relation("InvoiceCreator")
}

enum OperationState {
  PENDING
  COMPLETED
}

model Operation {
  id          String         @id @db.Uuid
  adminId     String         @db.Uuid
  route       String
  fingerprint String
  state       OperationState @default(COMPLETED)
  response    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  admin       Admin          @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([adminId, route, id])
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceTemplateAmountSource {
  FIXED
  CLASS_TUITION
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  COMPLETED
}

model Class {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  monthlyTuition BigInt
  status         ClassStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  students       Student[]

  @@index([status])
}

model Student {
  id        String        @id @default(uuid()) @db.Uuid
  fullName  String
  nickname  String?
  status    StudentStatus @default(ACTIVE)
  classId   String?       @db.Uuid
  class     Class?        @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  invoices  Invoice[]

  @@index([classId, status])
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  studentId        String        @db.Uuid
  billingMonth     DateTime      @db.Date
  studentName      String
  studentNickname  String?
  classId          String        @db.Uuid
  className        String
  status           InvoiceStatus @default(DRAFT)
  total            BigInt        @default(0)
  creatorId        String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  creator          Admin         @relation("InvoiceCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  items            InvoiceItem[]

  @@unique([studentId, billingMonth])
  @@index([billingMonth, status, classId, createdAt, id])
  @@index([billingMonth, createdAt(sort: Desc), id(sort: Desc)])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String
  feeGroup    String?
  amount      BigInt
  position    Int
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, position])
  @@index([invoiceId, position])
}

model InvoiceTemplate {
  id        String                @id @default(uuid()) @db.Uuid
  singleton Boolean               @unique @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     InvoiceTemplateItem[]
}

model InvoiceTemplateItem {
  id           String                      @id @default(uuid()) @db.Uuid
  templateId   String                      @db.Uuid
  description  String
  feeGroup     String?
  position     Int
  amountSource InvoiceTemplateAmountSource
  fixedAmount  BigInt?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  template     InvoiceTemplate             @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, position])
  @@index([templateId, position])
}

model BankAccount {
  id                String            @id @default(uuid()) @db.Uuid
  bankCode          String
  accountNumber     String
  accountHolderName String
  status            BankAccountStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
}
