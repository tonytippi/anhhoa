  id                  String             @id @default(uuid()) @db.Uuid
  schoolId            String             @db.Uuid
  studentId           String             @db.Uuid
  handoverOn          DateTime           @db.Date
  pickedUpAt          DateTime
  evidenceId          String?            @unique @db.Uuid
  policyEffectiveFrom DateTime           @db.Date
  actorIdentityId     String             @db.Uuid
  membershipId        String             @db.Uuid
  staffProfileId      String             @db.Uuid
  createdAt           DateTime           @default(now())
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student             Student            @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  evidence            EvidenceReference? @relation("HandoverEvidence", fields: [schoolId, evidenceId], references: [schoolId, id], onDelete: Restrict)
  policy              HandoverPolicy     @relation(fields: [schoolId, policyEffectiveFrom], references: [schoolId, effectiveFrom], onDelete: Restrict)
  membership          SchoolMembership   @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  staffProfile        StaffProfile       @relation(fields: [schoolId, staffProfileId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, studentId, handoverOn])
  @@unique([schoolId, evidenceId])
  @@index([schoolId, handoverOn])
}

model DailyJournalPolicy {
  id                                      String                      @id @default(uuid()) @db.Uuid
  schoolId                                String                      @db.Uuid
  effectiveFrom                           DateTime                    @db.Date
  parentRetentionDaysAfterEnrollmentEnded Int
  acceptedImageMimeTypes                  DailyJournalImageMimeType[]
  maxImageSizeBytes                       Int
  imageCountLimit                         Int?
  reason                                  String
  actorIdentityId                         String                      @db.Uuid
  membershipId                            String                      @db.Uuid
  createdAt                               DateTime                    @default(now())
  school                                  School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership                              SchoolMembership            @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  journals                                DailyJournal[]
  journalVersions                         DailyJournalVersion[]
  media                                   DailyJournalMedia[]

  @@unique([schoolId, effectiveFrom])
  @@unique([schoolId, id])
  @@index([schoolId, effectiveFrom])
}

model DailyJournal {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolId            String               @db.Uuid
  classId             String               @db.Uuid
  studentId           String               @db.Uuid
  enrollmentIdSnapshot String              @db.Uuid
  enrollmentEndedOnSnapshot DateTime?      @db.Date
  journalDate         DateTime             @db.Date
  text                String
  currentVersion      Int                  @default(1)
  policyEffectiveFrom DateTime             @db.Date
  actorIdentityId     String               @db.Uuid
  membershipId        String               @db.Uuid
  staffProfileId      String               @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classroom           Class                @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  student             Student              @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  policy              DailyJournalPolicy   @relation(fields: [schoolId, policyEffectiveFrom], references: [schoolId, effectiveFrom], onDelete: Restrict)
  membership          SchoolMembership     @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  staffProfile        StaffProfile         @relation(fields: [schoolId, staffProfileId], references: [schoolId, id], onDelete: Restrict)
  versions            DailyJournalVersion[]

  @@unique([schoolId, id])
  @@unique([schoolId, studentId, journalDate])
  @@index([schoolId, classId, journalDate])
}

model DailyJournalVersion {
  id                String              @id @default(uuid()) @db.Uuid
  schoolId          String              @db.Uuid
  dailyJournalId    String              @db.Uuid
  version           Int
  text              String
  policyEffectiveFrom DateTime          @db.Date
  actorIdentityId   String              @db.Uuid
  membershipId      String              @db.Uuid
  staffProfileId    String              @db.Uuid
  createdAt         DateTime            @default(now())
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  dailyJournal      DailyJournal        @relation(fields: [schoolId, dailyJournalId], references: [schoolId, id], onDelete: Restrict)
  membership        SchoolMembership    @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  staffProfile      StaffProfile        @relation(fields: [schoolId, staffProfileId], references: [schoolId, id], onDelete: Restrict)
  policy            DailyJournalPolicy  @relation(fields: [schoolId, policyEffectiveFrom], references: [schoolId, effectiveFrom], onDelete: Restrict)
  media             DailyJournalVersionMedia[]

  @@unique([schoolId, id])
  @@unique([schoolId, dailyJournalId, version])
}

model DailyJournalMedia {
  id                String              @id @default(uuid()) @db.Uuid
  schoolId          String              @db.Uuid
  classId           String              @db.Uuid
  studentId         String              @db.Uuid
  journalDate       DateTime            @db.Date
  contentType       String
  blob              Bytes
  uploadedByMembershipId String         @db.Uuid
  uploadedByStaffProfileId String       @db.Uuid
  policyEffectiveFrom DateTime          @db.Date
  attachedDailyJournalId String?        @db.Uuid
  createdAt         DateTime            @default(now())
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classroom         Class               @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  student           Student             @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  policy            DailyJournalPolicy  @relation(fields: [schoolId, policyEffectiveFrom], references: [schoolId, effectiveFrom], onDelete: Restrict)
  uploadedByMembership SchoolMembership @relation("DailyJournalMediaUploaderMembership", fields: [schoolId, uploadedByMembershipId], references: [schoolId, id], onDelete: Restrict)
  uploadedByStaffProfile StaffProfile   @relation("DailyJournalMediaUploader", fields: [schoolId, uploadedByStaffProfileId], references: [schoolId, id], onDelete: Restrict)
  versionMedia      DailyJournalVersionMedia[]

  @@unique([schoolId, id])
  @@index([schoolId, classId, studentId, journalDate])
  @@index([schoolId, attachedDailyJournalId])
}

model DailyJournalVersionMedia {
  schoolId              String              @db.Uuid
  dailyJournalVersionId String              @db.Uuid
  mediaId               String              @db.Uuid
  dailyJournalVersion   DailyJournalVersion @relation(fields: [schoolId, dailyJournalVersionId], references: [schoolId, id], onDelete: Restrict)
  media                 DailyJournalMedia   @relation(fields: [schoolId, mediaId], references: [schoolId, id], onDelete: Restrict)

  @@id([schoolId, dailyJournalVersionId, mediaId])
  @@index([schoolId, mediaId])
}

model BankAccount {
  id                   String                           @id @default(uuid()) @db.Uuid
  schoolId             String                           @db.Uuid
  receivingBank        String
  accountNumber        String
  accountHolderName    String
  transferTemplate     String
  actorIdentityId      String                           @db.Uuid
  membershipId         String                           @db.Uuid
  createdAt            DateTime                         @default(now())
  school               School                           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  membership           SchoolMembership                 @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  lifecycleTransitions BankAccountLifecycleTransition[]

  @@unique([schoolId, id])
  @@index([schoolId, createdAt])
}

model BankAccountLifecycleTransition {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @db.Uuid
  bankAccountId   String             @db.Uuid
  previousStatus  BankAccountStatus?
  status          BankAccountStatus
  reason          String?
  actorIdentityId String             @db.Uuid
  membershipId    String             @db.Uuid
  operationId     String             @db.Uuid
  sequence        Int
  changedAt       DateTime           @default(now())
  bankAccount     BankAccount        @relation(fields: [schoolId, bankAccountId], references: [schoolId, id], onDelete: Restrict)
  membership      SchoolMembership   @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  operation       Operation          @relation("BankAccountLifecycleOperation", fields: [schoolId, operationId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, bankAccountId, sequence])
  @@index([schoolId, bankAccountId, sequence])
  @@index([schoolId, operationId])
}
