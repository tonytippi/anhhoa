# Không điền thông tin thật vào file này. Sao chép thành .env cục bộ và điền các giá trị hợp lệ.
DATABASE_URL=
# Database test local only. `pnpm --filter api test:integration` ignores DATABASE_URL and only accepts this Compose URL.
# TEST_DATABASE_URL=postgresql://anhhoa_test:anhhoa_test@localhost:55432/anhhoa_test?schema=public
PORT=3000
WEB_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL callback đã đăng ký với Google, ví dụ http://localhost:3000/auth/google/callback.
GOOGLE_CALLBACK_URL=
# Danh sách URL sau đăng nhập, ngăn cách bằng dấu phẩy; mỗi URL phải được cho phép rõ ràng.
OAUTH_REDIRECT_URLS=http://localhost:5173
# Một URL trong OAUTH_REDIRECT_URLS dùng khi Google từ chối hoặc email không được phép.
OAUTH_DENIED_REDIRECT_URL=http://localhost:5173
# Secret JWT có ít nhất 32 ký tự.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Email Admin, ngăn cách bằng dấu phẩy. So sánh không phân biệt hoa-thường.
ADMIN_EMAILS=
CSRF_COOKIE_NAME=csrf_token
